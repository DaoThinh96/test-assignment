{
  "name": "playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npx playwright test tests/spec/web/demo.spec.ts --project=chromium",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure-single-file:generate": "allure generate --single-file allure-results --clean -o allure-report",
    "test:k6": "k6 run tests/spec/performance/k6-test.ts",
    "k6:specific:html-report": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=tests/spec/performance/report/html-report.html k6 run tests/spec/performance/k6-test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^18.0.0",
    "allure-playwright": "^3.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.0.0",
    "googleapis": "^170.1.0",
    "playwright": "^1.56.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/k6": "^1.5.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "csv-parse": "^5.5.6",
    "dayjs": "^1.11.10",
    "genson-js": "^0.0.8",
    "util": "^0.12.5"
  }
}
